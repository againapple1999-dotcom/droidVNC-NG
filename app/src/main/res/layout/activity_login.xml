<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remote Assistance"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/server_url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cloudflare Server URL (https://...)"
            android:inputType="textUri"
            android:singleLine="true"/>

        <Button
            android:id="@+id/btn_save_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Server URL"/>

        <EditText
            android:id="@+id/email_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email address"
            android:inputType="textEmailAddress"
            android:singleLine="true"/>

        <EditText
            android:id="@+id/password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:inputType="textPassword"
            android:singleLine="true"/>

        <Button
            android:id="@+id/btn_email_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sign In"/>

        <Button
            android:id="@+id/btn_create_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Account"/>

        <Button
            android:id="@+id/btn_reset_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forgot Password?"/>

        <Button
            android:id="@+id/btn_sign_out"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sign Out"/>

        <Button
            android:id="@+id/btn_register_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Register This Device"/>


        <Button
            android:id="@+id/btn_check_request"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check Connection Request"/>

        <Button
            android:id="@+id/btn_end_request"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="End Connection Request"/>

        <Button
            android:id="@+id/btn_start_remote_session"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start approved remote session" />

        <TextView
            android:id="@+id/login_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:text="Not signed in"/>

    </LinearLayout>
</ScrollView>
